.container {
  padding: 30rpx;
}

/* 筛选栏 */
.filter-bar {
  margin-bottom: 24rpx;
}

.filter-scroll {
  display: flex;
  white-space: nowrap;
  overflow: hidden;
}

.filter-item {
  display: inline-flex;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #f5f5f5;
  flex-shrink: 0;
}

.filter-item.active {
  background: #fff5f5;
  color: #ff6b6b;
  border-color: #ff6b6b;
  font-weight: bold;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 36rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #ccc;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.chart-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 10rpx;
  overflow: hidden;
}

.chart-tab {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #999;
  transition: all 0.2s;
}

.chart-tab.active {
  background: #ff6b6b;
  color: #fff;
  font-weight: bold;
}

.chart-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.chart-summary-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.summary-emoji {
  font-size: 30rpx;
  width: 40rpx;
  text-align: center;
}

.summary-name {
  color: #666;
  width: 100rpx;
}

.summary-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.summary-unit {
  font-size: 24rpx;
  color: #999;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.record-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.record-time {
  font-size: 24rpx;
  color: #ccc;
}

.record-plan {
  font-size: 22rpx;
  color: #ff6b6b;
  background: #fff5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: auto;
}

.record-stats {
  display: flex;
  justify-content: space-around;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.btn-clear {
  margin-top: 40rpx;
  background: transparent !important;
  color: #e74c3c !important;
  font-size: 28rpx;
  border: 2rpx solid #e74c3c !important;
  border-radius: 50rpx;
  padding: 20rpx 0;
}
