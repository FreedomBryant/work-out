<view class="container">
  <!-- 计划筛选 -->
  <view class="filter-bar" wx:if="{{plans.length > 0}}">
    <scroll-view class="filter-scroll" scroll-x enable-flex>
      <view
        class="filter-item {{currentPlanId === '' ? 'active' : ''}}"
        bindtap="selectAll"
      >全部</view>
      <view
        class="filter-item {{currentPlanId === item.id ? 'active' : ''}}"
        wx:for="{{plans}}"
        wx:key="id"
        data-planid="{{item.id}}"
        bindtap="selectPlan"
        style="{{currentPlanId === item.id ? 'color:' + item.color + ';border-color:' + item.color : ''}}"
      >{{item.name}}</view>
    </scroll-view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无记录</text>
    <text class="empty-hint">开始你的第一次锻炼吧！</text>
  </view>

  <view wx:else>
    <!-- 统计图表 -->
    <view class="chart-card">
      <view class="chart-header">
        <view class="chart-title">{{chartTitle}}</view>
        <view class="chart-tabs">
          <view class="chart-tab {{chartMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="switchChartMode">周</view>
          <view class="chart-tab {{chartMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchChartMode">月</view>
          <view class="chart-tab {{chartMode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="switchChartMode">年</view>
        </view>
      </view>
      <view class="chart-summary">
        <view class="chart-summary-item" wx:for="{{exerciseTotals}}" wx:key="name">
          <text class="summary-emoji">{{item.emoji}}</text>
          <text class="summary-name">{{item.name}}</text>
          <text class="summary-num">{{item.totalReps}}</text>
          <text class="summary-unit">个</text>
        </view>
      </view>
      <canvas type="2d" id="chart-canvas" class="chart-canvas"></canvas>
    </view>

    <!-- 记录列表 -->
    <view class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="index">
        <view class="record-header">
          <text class="record-date">{{item.date}}</text>
          <text class="record-time">{{item.finishTime}}</text>
          <text class="record-plan">{{item.planName}}</text>
        </view>
        <view class="record-stats">
          <view class="stat">
            <text class="stat-value">{{item.groupsComplete}}</text>
            <text class="stat-label">完成组数</text>
          </view>
          <view class="stat">
            <text class="stat-value">{{item.repsPerGroup}}</text>
            <text class="stat-label">每组个数</text>
          </view>
          <view class="stat">
            <text class="stat-value">{{item.totalReps}}</text>
            <text class="stat-label">总个数</text>
          </view>
        </view>
      </view>
    </view>

    <button
      class="btn-clear"
      bindtap="clearHistory"
    >清空历史</button>
  </view>
</view>
