.container {
  padding: 30rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 顶部返回栏 */
.top-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.btn-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.back-arrow {
  font-size: 44rpx;
  color: #666;
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  color: #666;
}

.plan-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.plan-badge-emoji {
  font-size: 28rpx;
}

.plan-badge-name {
  font-size: 24rpx;
  color: #fff;
}

.progress-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  width: 100%;
  margin-bottom: 30rpx;
  text-align: center;
}

.progress-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b, #ee5a24);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 30rpx;
  width: 100%;
  margin-bottom: 30rpx;
  text-align: center;
}

.status {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-icon {
  font-size: 80rpx;
}

.status-text {
  font-size: 32rpx;
  color: #333;
}

.countdown {
  font-size: 72rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.action-area {
  width: 100%;
  margin-bottom: 30rpx;
}

.btn-action {
  width: 100%;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24) !important;
  color: #fff !important;
  font-size: 36rpx;
  border-radius: 50rpx;
  padding: 28rpx 0;
}

.btn-complete {
  background: linear-gradient(135deg, #2ecc71, #27ae60) !important;
}

.summary {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.group-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.group-item {
  background: #e8f5e9;
  color: #2e7d32;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.btn-end {
  background: transparent !important;
  color: #999 !important;
  font-size: 28rpx;
  border: none !important;
  text-decoration: underline;
}
