.container {
  padding: 30rpx;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
}

.value-text {
  font-size: 28rpx;
  color: #999;
}

.btn-row {
  margin-top: 20rpx;
}

.btn-danger {
  background: transparent !important;
  color: #e74c3c !important;
  font-size: 28rpx;
  border: 2rpx solid #e74c3c !important;
  border-radius: 50rpx;
  padding: 20rpx 0;
  width: 100%;
}
