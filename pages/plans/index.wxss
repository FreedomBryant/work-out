page,
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.btn-add {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 30rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  border-radius: 40rpx;
}

.btn-add-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

.btn-add-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-bottom: 40rpx;
}

.plan-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  min-height: 200rpx;
}

.plan-cover {
  width: 200rpx;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  position: relative;
}

.plan-emoji {
  font-size: 60rpx;
}

.plan-type-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 20rpx;
  background: rgba(255,255,255,0.8);
  color: #999;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.plan-info {
  flex: 1;
  padding: 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.plan-stats {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.plan-stat {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.plan-progress {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plan-progress-text {
  font-size: 22rpx;
  color: #666;
}

.plan-progress-bar {
  width: 100%;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.plan-progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.plan-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}

.plan-action-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  text-align: center;
  min-width: 90rpx;
}

.edit-btn {
  background: #f0f0f0;
  color: #666;
}

.delete-btn {
  background: #fff2f0;
  color: #ff4d4f;
}

.btn-hover {
  opacity: 0.7;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #ccc;
}
