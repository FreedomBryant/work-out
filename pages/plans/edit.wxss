.container {
  padding: 30rpx;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
}

.form-value {
  font-size: 30rpx;
  color: #333;
  display: block;
  padding: 10rpx 0;
}

/* 封面预览 */
.cover-preview {
  width: 200rpx;
  height: 160rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-emoji {
  font-size: 60rpx;
}

.cover-actions {
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  background: #ff6b6b;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  line-height: 1.4;
  display: inline-block;
}

.mini-btn-light {
  background: #f0f0f0;
  color: #666;
}

/* 颜色选择器 */
.color-picker {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 4rpx solid transparent;
}

.color-dot.active {
  border-color: #333;
}

/* Emoji 选择器 */
.emoji-picker {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.emoji-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
}

.emoji-item.active {
  border-color: #ff6b6b;
  background: #fff5f5;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.step-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
}

.step-btn:active {
  background: #e0e0e0;
}

.value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
  min-width: 80rpx;
  text-align: center;
}

/* 保存按钮 */
.btn-save {
  background: #ff6b6b;
  color: #fff;
  font-size: 32rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
  margin-top: 20rpx;
}

.btn-save[disabled] {
  opacity: 0.6;
}
